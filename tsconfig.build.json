{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationDir": "./dist/types",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  "exclude": [
    "src/demo",
    "src/test",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
